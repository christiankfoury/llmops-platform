# Local Java Compose defaults only. Existing .env files are never overwritten.
# Compose forwards only its explicitly listed settings; never use real cloud credentials here.
API_PORT=8000
WEB_PORT=3000
POSTGRES_PORT=55432
REDIS_PORT=56379
POSTGRES_USER=ai_platform
POSTGRES_PASSWORD=local_dev_password
JDBC_DATABASE_URL=jdbc:postgresql://postgres:5432/ai_platform

# Compose uses a new PostgreSQL volume, mock provider and isolated read-only web fixtures.
# Native Java/OIDC settings: apps/api-java/.env.example and docs/java-runtime-cutover.md.
# Python reference settings: apps/api/.env.example and docker-compose.python-reference.yml.

# Placeholder-only Proofbase local telemetry configuration.
# Use these values in Proofbase's local environment when telemetry phases are enabled.
PROOFBASE_TELEMETRY_ENABLED=false
PROOFBASE_TELEMETRY_ENDPOINT=http://localhost:8000/v1/usage/llm-events
PROOFBASE_TELEMETRY_API_KEY=proofbase-local-placeholder-key-not-a-secret
PROOFBASE_TELEMETRY_TIMEOUT_SECONDS=2
PROOFBASE_TELEMETRY_MAX_METADATA_BYTES=2048
PROOFBASE_TELEMETRY_REDACT_CONTENT=true

# Placeholder-only AgentOps local telemetry configuration.
# Use these values in AgentOps' local environment when telemetry phases are enabled.
AGENTOPS_TELEMETRY_ENABLED=false
AGENTOPS_TELEMETRY_ENDPOINT=http://localhost:8000/v1/usage/llm-events
AGENTOPS_TELEMETRY_API_KEY=agentops-local-placeholder-key-not-a-secret
AGENTOPS_TELEMETRY_TIMEOUT_SECONDS=2
AGENTOPS_TELEMETRY_MAX_METADATA_BYTES=2048
AGENTOPS_TELEMETRY_REDACT_CONTENT=true
