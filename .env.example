# Local development defaults only. Copy to .env if you need overrides.
ENVIRONMENT=local
API_PORT=8000
WEB_PORT=3000
POSTGRES_PORT=55432
REDIS_PORT=56379

POSTGRES_DB=ai_platform
POSTGRES_USER=ai_platform
POSTGRES_PASSWORD=local_dev_password
DATABASE_URL=postgresql+psycopg://ai_platform:local_dev_password@postgres:5432/ai_platform

REDIS_URL=redis://redis:6379/0
API_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
OTEL_TRACING_ENABLED=false
OTEL_SERVICE_NAME=production-ai-platform-api
OTEL_TRACES_EXPORTER=console
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318/v1/traces
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_WINDOW_SECONDS=60

NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
