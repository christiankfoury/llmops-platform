# Local development defaults only. Copy to .env if you need overrides.
ENVIRONMENT=local
API_PORT=8000
WEB_PORT=3000
POSTGRES_PORT=55432
REDIS_PORT=56379

POSTGRES_DB=ai_platform
POSTGRES_USER=ai_platform
POSTGRES_PASSWORD=local_dev_password
DATABASE_URL=postgresql+psycopg://ai_platform:local_dev_password@postgres:5432/ai_platform

REDIS_URL=redis://redis:6379/0
API_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
OTEL_TRACING_ENABLED=false
OTEL_SERVICE_NAME=production-ai-platform-api
OTEL_TRACES_EXPORTER=console
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318/v1/traces
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_WINDOW_SECONDS=60
PROVIDER_MAX_ATTEMPTS=2
PROVIDER_RETRY_BACKOFF_MS=100
PROVIDER_TIMEOUT_SECONDS=15

# Placeholder-only Proofbase local telemetry configuration.
# Use these values in Proofbase's local environment when telemetry phases are enabled.
PROOFBASE_TELEMETRY_ENABLED=false
PROOFBASE_TELEMETRY_ENDPOINT=http://localhost:8000/v1/usage/llm-events
PROOFBASE_TELEMETRY_API_KEY=proofbase-local-placeholder-key-not-a-secret
PROOFBASE_TELEMETRY_TIMEOUT_SECONDS=2
PROOFBASE_TELEMETRY_MAX_METADATA_BYTES=2048
PROOFBASE_TELEMETRY_REDACT_CONTENT=true

NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
