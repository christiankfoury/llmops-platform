aws_region                = "us-east-1"
vpc_cidr                  = "10.40.0.0/16"
az_count                  = 3
enable_nat_gateway        = true
kubernetes_version = "1.36"
eks_endpoint_public_access = false
eks_endpoint_private_access = true
database_instance_class = "db.t4g.medium"
database_backup_retention_days = 14
database_deletion_protection = true
redis_node_type = "cache.t4g.medium"
redis_num_cache_clusters = 2
max_tagged_images         = 60
secret_recovery_window_in_days = 30
budget_alert_enabled      = false
budget_monthly_limit_usd  = "650"
budget_alert_subscriber_emails = []
create_github_actions_role = false
github_repository         = "christiankfoury/llmops-platform"

# Resolve actual role and add-on versions through read-only AWS preflight before any plan/apply.
bootstrap_principal_arn = "arn:aws:iam::000000000000:role/replace-with-bootstrap-role"
# eks_addon_versions = { vpc_cni = "<verified-build>", coredns = "<verified-build>", kube_proxy = "<verified-build>", ebs_csi = "<verified-build>", metrics_server = "<verified-build>" }
# Supply TF_VAR_redis_auth_token through approved secret delivery, never a tfvars file or logs.
redis_auth_token_version = 1

# First stage false; enable only after approved bootstrap policies are installed.
bootstrap_addons_enabled = false
