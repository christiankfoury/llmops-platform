{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "environment",
    "region",
    "vpcCidr",
    "secretPrefix",
    "roles",
    "externalSecretsEnabled"
  ],
  "properties": {
    "environment": {
      "enum": [
        "dev",
        "staging",
        "prod"
      ]
    },
    "region": {
      "type": "string",
      "minLength": 1
    },
    "vpcCidr": {
      "type": "string",
      "pattern": "^([0-9]{1,3}\\.){3}[0-9]{1,3}/[0-9]{1,2}$"
    },
    "secretPrefix": {
      "type": "string",
      "minLength": 1
    },
    "externalSecretsEnabled": {
      "type": "boolean"
    },
    "roles": {
      "type": "object",
      "required": [
        "runtime",
        "migration",
        "loadBalancer"
      ],
      "properties": {
        "runtime": {
          "type": "string",
          "pattern": "^arn:aws:iam::[0-9]{12}:role/.+$"
        },
        "migration": {
          "type": "string",
          "pattern": "^arn:aws:iam::[0-9]{12}:role/.+$"
        },
        "loadBalancer": {
          "type": "string",
          "pattern": "^arn:aws:iam::[0-9]{12}:role/.+$"
        }
      }
    }
  }
}
