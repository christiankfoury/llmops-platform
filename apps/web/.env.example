# Closed by default. synthetic_demo serves fixed fixtures without backend access.
WEB_AUTH_MODE=disabled
ENVIRONMENT=local
WEB_ORIGIN=http://localhost:3000
API_BASE_URL=http://localhost:8080
OIDC_ISSUER=https://identity.example.invalid
OIDC_AUDIENCE=https://api.example.invalid
OIDC_CLIENT_ID=dashboard-placeholder
OIDC_CLIENT_SECRET=
# Supply a random 32-byte base64url value through the environment; never commit it.
WEB_SESSION_SECRET=
