# Documentation only: Java reads process environment, not .env files automatically.
ENVIRONMENT=local
API_BIND_ADDRESS=127.0.0.1
PORT=8080
OPERATOR_AUTH_MODE=disabled
OIDC_ISSUER=https://identity.example.invalid
OIDC_AUDIENCE=https://api.example.invalid
OIDC_JWKS_URI=https://identity.example.invalid/jwks
# Explicit grant command inputs; no automatic grants or real subjects are included.
OPERATOR_SUBJECT=synthetic-placeholder-subject
OPERATOR_PROJECT_SLUG=demo-project
OPERATOR_ROLE=viewer
