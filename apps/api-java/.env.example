# Documentation only: Java reads process environment, not .env files automatically.
ENVIRONMENT=local
API_BIND_ADDRESS=127.0.0.1
PORT=8080
OPERATOR_AUTH_MODE=disabled
OIDC_ISSUER=https://identity.example.invalid
OIDC_AUDIENCE=https://api.example.invalid
OIDC_JWKS_URI=https://identity.example.invalid/jwks
# Explicit grant command inputs; no automatic grants or real subjects are included.
OPERATOR_SUBJECT=synthetic-placeholder-subject
OPERATOR_PROJECT_SLUG=demo-project
OPERATOR_ROLE=viewer

# Required Redis; hosted environments require TLS and an externally supplied password.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_TLS_ENABLED=false
LIMITS_NAMESPACE=ai-platform-local
GLOBAL_REQUEST_LIMIT=600
GATEWAY_KEY_REQUEST_LIMIT=60
TELEMETRY_KEY_REQUEST_LIMIT=300
RATE_LIMIT_WINDOW_SECONDS=60
MAX_CONCURRENT_REQUESTS=32
# Total execution budget across attempts, queue and backoff; maximum 20 seconds.
PROVIDER_TIMEOUT_SECONDS=15
